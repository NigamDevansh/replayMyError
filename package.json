{
    "name": "error-replay",
    "version": "2.0.0",
    "description": "Lightweight error replay package that records user actions and generates detailed error reports",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "import": "./dist/config.js",
            "require": "./dist/config.cjs",
            "default": "./dist/config.js"
        }
    },
    "peerDependencies": {
        "@slack/web-api": "^7.0.0"
    },
    "peerDependenciesMeta": {
        "@slack/web-api": {
            "optional": true
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=16"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "clean": "rm -rf dist",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run clean && npm run build"
    },
    "keywords": [
        "error",
        "replay",
        "debugging",
        "tracking",
        "error-reporting",
        "user-actions",
        "react",
        "typescript",
        "error-tracking",
        "session-replay"
    ],
    "author": "devanshnigam",
    "license": "MIT",
    "devDependencies": {
        "@slack/web-api": "^7.16.0",
        "@types/node": "^25.5.0",
        "tsup": "^8.5.1",
        "typescript": "^5.3.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NigamDevansh/replayMyError.git"
    },
    "bugs": {
        "url": "https://github.com/NigamDevansh/replayMyError/issues"
    },
    "homepage": "https://github.com/NigamDevansh/replayMyError#readme"
}
